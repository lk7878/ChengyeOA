{
  "name": "law-firm-system",
  "version": "1.0.0",
  "description": "律所闭环管理系统 - Law Firm Management System",
  "private": true,
  "scripts": {
    "dev:server": "cd apps/server && npm run dev",
    "dev:web": "cd apps/web && npm run dev",
    "build:web": "cd apps/web && npm run build",
    "build:server": "cd apps/server && npm run build",
    "package": "cd apps/web && npm run build && cd ../server && node scripts/build-package.js",
    "installer": "cd ../scripts && build-installer.bat",
    "build:all": "npm run build:web && npm run build:server",
    "db:up": "docker compose -f infra/postgres/compose.yml up -d postgres",
    "db:down": "docker compose -f infra/postgres/compose.yml down",
    "db:logs": "docker compose -f infra/postgres/compose.yml logs -f postgres",
    "db:reset:test": "cd apps/server && npm run db:reset:test",
    "migration:inventory": "npm --prefix apps/server run migration:inventory --",
    "migration:diff": "npm --prefix apps/server run migration:diff --",
    "migration:import": "npm --prefix apps/server run migration:import --",
    "migration:validate": "npm --prefix apps/server run migration:validate --"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
