{
  "name": "@chengyeoa/dsh-oa-bridge",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "host.mjs",
  "exports": {
    ".": "./host.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-product-knowledge",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
