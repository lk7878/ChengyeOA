  lastSuccessfulTickAt DateTime? @db.Timestamptz(3)
  lastStoppedAt        DateTime? @db.Timestamptz(3)
  version              Int       @default(1)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)

  @@map("event_worker_runtime_status")
}

model Notification {
