NODE_ENV=development
# Optional password-only login for development with a loopback database; rejected elsewhere.
LOCAL_PASSWORD_LOGIN=false
PORT=7001
DATABASE_URL="postgresql://chengye_app:chengye_local_only@localhost:55432/chengye_oa?schema=public"
DATABASE_URL_TEST="postgresql://chengye_test:chengye_test_local_only@localhost:55432/chengye_oa_test?schema=public"
JWT_SECRET="replace_with_at_least_32_random_characters"
APP_KEYS="replace_with_first_application_key,replace_with_second_application_key"
MFA_ENCRYPTION_KEY_V1="replace_with_base64_encoded_32_byte_key"
CORS_ALLOWED_ORIGINS="http://localhost:3000"
LOG_LEVEL=info
LOG_DIR=./logs
ALLOW_SUPER_ADMIN_RECOVERY=false
# Event rollout observability (all values are decimal integers).
EVENT_OBSERVABILITY_HEARTBEAT_SECONDS=10
EVENT_OBSERVABILITY_UNDISPATCHED_BLOCK_SECONDS=120
EVENT_OBSERVABILITY_DUE_BACKLOG_BLOCK_SECONDS=300
EVENT_OBSERVABILITY_LEASE_LOST_DEGRADED_COUNT=1
EVENT_OBSERVABILITY_LEASE_LOST_BLOCKED_COUNT=3
EVENT_OBSERVABILITY_CANARY_WINDOW_MINUTES=15
# Lead first-response timeout recycle scanner (SPEC-009 Task 9; driven by the event worker tick).
# LEAD_RECYCLE_ENABLED must be exactly true or false (default true when unset).
# LEAD_RECYCLE_NO_FOLLOW_HOURS is a decimal integer between 1 and 720 (default 24).
LEAD_RECYCLE_ENABLED=true
LEAD_RECYCLE_NO_FOLLOW_HOURS=24
# Approval timeout escalation scanner (SPEC-021; driven by the event worker tick).
# APPROVAL_TIMEOUT_HOURS is a decimal integer between 1 and 8760 (default 72).
# PENDING approval tasks older than this threshold on a still-PENDING instance get a
# daily APPROVAL notification reminder to their assignee (dedup by UTC day).
APPROVAL_TIMEOUT_HOURS=72
