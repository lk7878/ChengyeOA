{
  "name": "@deepseek-ai/dsh-product-bundle",
  "description": "Formal product composition for the dedicated profile",
  "version": "0.1.2-alpha.2",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/deepseek-ai/deepseek-harness.git", "directory": "packages/product/product-bundle" },
  "type": "module",
  "scripts": {
    "verify:profile": "tsx scripts/verify-profile.ts"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "files": ["lib/index.js", "lib/invariant.js", "cordis.patch.yml", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-product-knowledge": "workspace:^",
    "@deepseek-ai/dsh-product-knowledge-context": "workspace:^"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "workspace:^", "@deepseek-ai/dsh-invariants": "workspace:^" },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.0"
  }
}
