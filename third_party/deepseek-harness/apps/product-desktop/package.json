{
  "name": "@deepseek-ai/dsh-product-desktop",
  "description": "Minimal Windows desktop host for the DeepSeek Harness product profile",
  "version": "0.1.0-dev.1",
  "private": true,
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "dev": "pnpm run build && electron .",
    "test": "vitest run --root ../.. apps/product-desktop/tests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "electron": "43.4.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
