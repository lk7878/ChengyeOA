COOKIE_DOMAIN=.162-14-78-238.sslip.io
COOKIE_SECURE=1
AI_PUBLIC_BASE=https://ai.162-14-78-238.sslip.io
WORKBENCH_PUBLIC_BASE=https://162.14.78.238:10443
KB_PUBLIC_BASE=https://kb.162-14-78-238.sslip.io

# 可选：额外允许访问鉴定助手的 Host（逗号分隔）。通常留空即可，start-harness.ps1 会从 AI_PUBLIC_BASE 推导。
