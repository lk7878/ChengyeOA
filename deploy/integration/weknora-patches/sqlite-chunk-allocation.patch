+
+// One connection does not serialize an allocation followed by a separate insert.
+func TestCreateChunks_SQLite_ConcurrentAllocation(t *testing.T) {
+	db := setupChunkTestDB(t)
+	sqlDB, err := db.DB()
+	require.NoError(t, err)
+	sqlDB.SetMaxOpenConns(1)
+	repo := NewChunkRepository(db)
+	const workers = 26
+	var wg sync.WaitGroup
+	errs := make(chan error, workers)
+	start := make(chan struct{})
+	for i := 0; i < workers; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			chunks := make([]*types.Chunk, 120)
+			for j := range chunks {
+				chunks[j] = makeChunk("kb", uuid.New().String(), "text")
+			}
+			errs <- repo.CreateChunks(context.Background(), chunks)
+		}()
+	}
+	close(start)
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		require.NoError(t, err)
+	}
+	var count, distinct int64
+	require.NoError(t, db.Model(&types.Chunk{}).Count(&count).Error)
+	require.NoError(t, db.Model(&types.Chunk{}).Distinct("seq_id").Count(&distinct).Error)
+	require.EqualValues(t, workers*120, count)
+	require.Equal(t, count, distinct)
+}
